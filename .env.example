# Local development template only. Replace credentials before any public deployment.
POSTGRES_USER=esports
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=esports_platform
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me-locally

# The connection URIs below should match the variables above.
# Docker Compose publishes PostgreSQL on host port 5433 by default.
DATABASE_URL=postgresql://esports:change-me-locally@localhost:5433/esports_platform
MONGODB_URI=mongodb://root:change-me-locally@localhost:27017/esports_audit?authSource=admin
MONGODB_DB=esports_audit
SESSION_SECRET=replace_this_with_a_random_secret_at_least_32_characters_long
NODE_ENV=development
APP_URL=http://localhost:3000

# Optional, isolated databases for automated integration tests.
# Leave blank to run unit tests only; integration tests are skipped until configured.
TEST_DATABASE_URL=
TEST_MONGODB_URI=
