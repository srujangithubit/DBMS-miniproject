# Local development template only. Replace credentials before any public deployment.
POSTGRES_USER=esports
POSTGRES_PASSWORD=esports_dev_only
POSTGRES_DB=esports_platform
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=mongo_dev_only

# The connection URIs below should match the variables above.
# Node.js reads these values directly; use complete URLs (do not rely on shell expansion).
DATABASE_URL=postgresql://esports:esports_dev_only@localhost:5432/esports_platform
MONGODB_URI=mongodb://root:mongo_dev_only@localhost:27017/esports_audit?authSource=admin
MONGODB_DB=esports_audit
SESSION_SECRET=replace_this_with_a_random_secret_at_least_32_characters_long
NODE_ENV=development
APP_URL=http://localhost:3000
